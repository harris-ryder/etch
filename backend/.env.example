# Provider selection. A key is required: there is no offline fallback.
#   auto        OpenRouter if OPENROUTER_API_KEY is set, else OpenAI if OPENAI_API_KEY is set.
#   openrouter | openai   force one.
ETCH_PROVIDER=auto

# --- OpenRouter (https://openrouter.ai/keys) -------------------------------
OPENROUTER_API_KEY=
# Any chat model slug from https://openrouter.ai/models
OPENROUTER_TEXT_MODEL=openai/gpt-6-luna
# Any slug from https://openrouter.ai/api/v1/images/models
OPENROUTER_IMAGE_MODEL=krea/krea-2-medium-turbo
# low | medium | high (default medium, about $0.04 an image; high is about $0.17 and slower). Only sent by default for openai/* image models; set it to
# force it for another model that supports `quality`.
# OPENROUTER_IMAGE_QUALITY=medium

# --- OpenAI direct ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high. Higher gives finer linework but slower, more expensive images.
OPENAI_IMAGE_QUALITY=medium

PORT=8787
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
